# Copy this file to .env and fill in your local values.
# Do not commit .env.

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_BATCH_SIZE=10
DEEPSEEK_MAX_TOPIC_CHARS=6000
DEEPSEEK_TEMPERATURE=0.1

# zsxq-cli entry. Use a global binary, a local npm binary, or npx.
ZSXQ_CLI=npx --no-install zsxq-cli
ZSXQ_TIMEOUT_SECONDS=60

# Optional: point zsxq-cli auth/config files to a project-local runtime home.
# Useful when Codex sandbox cannot access C:\Users\<you>\.config.
# Run auth login with the same HOME/USERPROFILE path before using it.
# ZSXQ_RUNTIME_HOME=.runtime-home

# Keep these commands read-only. Adjust only the flags if your zsxq-cli version differs.
ZSXQ_GROUP_LIST_ARGS=--json
ZSXQ_TOPIC_SEARCH_ARGS=--group-id {group_id} --query {keyword} --json
ZSXQ_TOPIC_DETAIL_ARGS=--topic-id {topic_id} --json

# Optional local cost controls. 0 means unlimited for MAX_TOPICS.
MAX_KEYWORDS=40
MAX_TOPICS=0

# Optional recent topic stream scan. 0 means disabled.
# This uses read-only: zsxq-cli group +topics --group-id ... --limit ... --json
RECENT_PAGES=0
RECENT_LIMIT=30

# detail_search = topic detail + search hit context
# detail = topic detail only
# search = search hit context only
ANALYSIS_SOURCE=detail_search
